{
  "name": "blink-tarjeta",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "BLINK TARJETA — portal del pasajero para consultar y recargar la tarjeta de transporte.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lote": "node scripts/lote.ts",
    "deploy": "npm run build -- --base=/TARJETA/ && gh-pages -d dist -t"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bwip-js": "^4.11.4",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
